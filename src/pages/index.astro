---
import resources from "../../resources.json";
import { serializeResources, validateResources } from "../lib/resources.js";
import { latestVersion } from "../lib/version.js";

const resourceData = serializeResources(validateResources(resources));
const version = await latestVersion();
---
<!doctype html>
<html lang="zh-CN" data-theme="crimson">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0c0d11" />
    <meta
      name="description"
      content="Code Amadeus：支持语音与文字对话、角色呈现和任务委派的桌面应用。查看安装说明，下载语音、角色与场景资源。"
    />
    <meta property="og:title" content="Code Amadeus — 你好，我是 Amadeus。" />
    <meta
      property="og:description"
      content="Code Amadeus：支持语音与文字对话、角色呈现和任务委派的桌面应用。查看安装说明，下载语音、角色与场景资源。"
    />
    <meta property="og:type" content="website" />
    <title>Code Amadeus — 项目与资源中心</title>
    <link rel="icon" href="./favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="./apple-touch-icon.png" />
    <link rel="stylesheet" href="./styles.css" />
    <script is:inline>
      // Apply the saved theme before first paint so the page never flashes the default palette.
      try {
        if (localStorage.getItem("amadeus-site-theme") === "crt") {
          delete document.documentElement.dataset.theme;
          document
            .querySelector('meta[name="theme-color"]')
            .setAttribute("content", "#101b17");
        }
      } catch {
        /* Storage is optional. */
      }
    </script>
    <script
      is:inline
      id="resource-data"
      type="application/json"
      set:html={resourceData}
    />
    <script is:inline src="./app.js" defer></script>
  </head>
  <body>
    <svg width="0" height="0" aria-hidden="true" style="position: absolute">
      <!-- Remaps the mint artwork by brightness: shadows to black, jade hair to red, pale face to ivory. -->
      <filter id="crimson-tone" color-interpolation-filters="sRGB">
        <feColorMatrix
          type="matrix"
          values="0.2126 0.7152 0.0722 0 0  0.2126 0.7152 0.0722 0 0  0.2126 0.7152 0.0722 0 0  0 0 0 1 0"
        />
        <feComponentTransfer>
          <feFuncR type="table" tableValues="0 0.02 0.42 0.6 0.7 0.74 0.78 0.84 0.9 0.93 0.93" />
          <feFuncG type="table" tableValues="0 0 0.08 0.13 0.17 0.2 0.25 0.45 0.74 0.88 0.9" />
          <feFuncB type="table" tableValues="0 0 0.07 0.1 0.13 0.16 0.2 0.38 0.66 0.8 0.82" />
        </feComponentTransfer>
      </filter>
    </svg>
    <a class="skip-link" href="#main" data-i18n="skip">跳到主要内容</a>
    <header class="site-header">
      <div class="shell nav-inner">
        <a class="brand" href="#" aria-label="Code Amadeus"
          ><img
            class="brand-mark"
            src="./assets/logo.png"
            width="32"
            height="32"
            alt=""
          /><span>CODE <strong>AMADEUS</strong></span></a
        >
        <nav aria-label="主导航" data-i18n-aria="navigation">
          <a href="#experience" data-i18n="navExperience">认识 Amadeus</a>
          <a href="#resources" data-i18n="navResources">资源中心</a>
          <a href="#start" data-i18n="navStart">开始使用</a>
        </nav>
        <div class="nav-tools">
          <button
            id="theme-toggle"
            class="theme-toggle"
            type="button"
            aria-label="切换为 CRT 绿色主题"
          >
            CRT <span aria-hidden="true">◐</span></button
          ><button
            id="language-toggle"
            class="language-toggle"
            type="button"
            aria-label="Switch to English"
          >
            EN <span aria-hidden="true">↗</span></button
          ><a class="github-link" href="https://github.com/Code-Amadeus/Amadeus"
            >GitHub <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
    </header>
    <main id="main">
      <section class="hero shell" aria-labelledby="hero-title">
        <div class="hero-copy">
          <div class="eyebrow">
            <span class="status-dot"></span> AI DESKTOP COMPANION
          </div>
          <h1 id="hero-title">
            <span data-i18n="heroFirst">你好，</span><br /><span
              class="accent"
              data-i18n="heroSecond"
              >我是 Amadeus。</span
            >
          </h1>
          <p class="hero-description" data-i18n="heroDescription">我住在你的桌面上。想聊什么直接说，我会实时回应你，我也很好奇你会说些什么。有事要办就交给我，我会找帮手分头去做，每一步都摊开给你看。</p>
          <div class="hero-actions">
            <a class="button primary" href="#resources"
              ><span data-i18n="exploreResources">浏览资源</span
              ><span aria-hidden="true">↗</span></a
            ><a
              class="button secondary"
              href="https://www.bilibili.com/video/BV1783G6hEYY/"
              ><span class="play" aria-hidden="true">▷</span
              ><span data-i18n="watchDemo">观看演示</span></a
            >
          </div>
          <div class="hero-note">
            <span class="mono">SOURCE ALPHA / {version}</span
            ><span data-i18n="sourceAvailable">源码开放 · Alpha 版本</span>
          </div>
        </div>
        <figure class="hero-art">
          <div class="art-coordinate mono" aria-hidden="true">
            PRESENCE SIGNAL / 001
          </div>
          <img
            src="./assets/character.png"
            width="1511"
            height="1041"
            fetchpriority="high"
            alt="以点阵呈现的 Amadeus 角色品牌插画"
            data-i18n-alt="heroAlt"
          />
          <figcaption>
            <span class="signal-bars" aria-hidden="true"
              ><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span
            ><span class="mono">VOICE · PRESENCE · ACTION</span
            ><span class="art-label" data-i18n="brandArtwork">品牌视觉</span>
          </figcaption>
        </figure>
      </section>
      <div
        class="principles shell"
        aria-label="核心体验"
        data-i18n-aria="coreExperience"
      >
        <span><b>01</b> TALK <em data-i18n="principleTalk">实时对话</em></span
        ><span
          ><b>02</b> EMBODY <em data-i18n="principleEmbody">角色形象</em></span
        ><span><b>03</b> ACT <em data-i18n="principleAct">任务委派</em></span
        ><span
          ><b>04</b> CONTROL
          <em data-i18n="principleControl">权限控制</em></span
        >
      </div>

      <section
        id="experience"
        class="experience shell section-space"
        aria-labelledby="experience-title"
      >
        <div class="section-heading">
          <div>
            <p class="eyebrow">01 / THE EXPERIENCE</p>
            <h2 id="experience-title" data-i18n="experienceTitle">用自然语言委派任务</h2>
          </div>
          <p data-i18n="experienceIntro">描述你需要完成的任务，Amadeus 会将其交给执行智能体。你可以查看执行进度，并在需要时停止任务。</p>
        </div>
        <div class="experience-grid">
          <a
            class="demo-frame"
            href="https://www.bilibili.com/video/BV1783G6hEYY/"
            aria-label="在 Bilibili 观看 Amadeus 演示"
            data-i18n-aria="demoAria"
          >
            <div class="frame-bar">
              <span><i></i><i></i><i></i></span
              ><span class="mono">AMADEUS / WORKSPACE</span
              ><span aria-hidden="true">↗</span>
            </div>
            <img
              src="./assets/workspace.jpg"
              alt="Amadeus 工作区中的角色、任务进度与执行结果"
              data-i18n-alt="workspaceAlt"
              width="1600"
              height="900"
              loading="lazy"
            />
            <div class="demo-caption">
              <span
                ><span class="play" aria-hidden="true">▷</span>
                <span data-i18n="fullDemo">观看完整演示</span></span
              ><span class="mono">10 MIN / BILIBILI ↗</span>
            </div>
          </a>
          <div class="feature-list">
            <article>
              <span class="feature-number">01</span>
              <div>
                <h3 data-i18n="featureVoice">支持语音打断</h3>
                <p data-i18n="featureVoiceBody">可用语音或文字交流，也可以打断正在播放的回应。字幕和角色口型跟随语音播放，表情随对话变化。</p>
              </div>
            </article>
            <article>
              <span class="feature-number">02</span>
              <div>
                <h3 data-i18n="featureWork">集中查看任务进度</h3>
                <p data-i18n="featureWorkBody">任务由执行智能体处理。进度、中间产物与最终结果集中展示在同一个工作区中。</p>
              </div>
            </article>
            <article>
              <span class="feature-number">03</span>
              <div>
                <h3 data-i18n="featureControl">权限请求清晰可见</h3>
                <p data-i18n="featureControlBody">执行智能体需要额外权限时，会显示请求内容。你可以批准或拒绝，也可以停止任务。</p>
              </div>
            </article>
          </div>
        </div>
        <p class="section-footnote" data-i18n="demoNote">
          画面来自项目原型演示；当前界面持续迭代，具体功能与配置以文档为准。
        </p>
      </section>

      <section
        id="resources"
        class="resource-section section-space"
        aria-labelledby="resources-title"
      >
        <div class="shell">
          <div class="section-heading">
            <div>
              <p class="eyebrow">02 / RESOURCE LIBRARY</p>
              <h2 id="resources-title" data-i18n="resourcesTitle">为 Amadeus 添加声音与形象</h2>
            </div>
            <p data-i18n="resourcesIntro">语音、角色与场景资源包分别安装，可按需下载。不安装这些资源包，也可以使用文字对话与任务功能。</p>
          </div>
          <div class="library-notice">
            <span class="notice-icon" aria-hidden="true">i</span>
            <p data-i18n="resourcesNotice">
              资源入口准备中。网盘链接将陆续补充；此处提供独立资源包，不包含桌面安装程序。
            </p>
            <a
              href="https://github.com/Code-Amadeus/Amadeus/blob/main/docs/external_asset_bundles.md"
              ><span data-i18n="installGuide">安装说明</span> ↗</a
            >
          </div>
          <div class="library-toolbar">
            <div
              class="filters"
              role="group"
              aria-label="按资源类型筛选"
              data-i18n-aria="filterAria"
            >
              <button
                type="button"
                data-filter="all"
                aria-pressed="true"
                data-i18n="filterAll"
              >
                全部资源</button
              ><button
                type="button"
                data-filter="voice"
                aria-pressed="false"
                data-i18n="filterVoice"
              >
                语音与模型</button
              ><button
                type="button"
                data-filter="art"
                aria-pressed="false"
                data-i18n="filterArt"
              >
                角色与美术
              </button>
            </div>
            <span
              id="resource-count"
              class="mono"
              role="status"
              aria-live="polite"
            ></span>
          </div>
          <div
            id="resource-grid"
            class="resource-grid"
            aria-label="资源列表"
            data-i18n-aria="resourceList"
          ></div>
          <noscript
            ><p>
              请启用 JavaScript
              查看资源分类与网盘入口，也可阅读<a
                href="https://github.com/Code-Amadeus/Amadeus/blob/main/docs/external_asset_bundles.md"
                >资源安装说明</a
              >。
            </p></noscript
          >
          <p class="resource-footnote" data-i18n="resourceNote">
            所有资源均为可选项。没有角色包，也可以使用文字 Chat 与
            Work；本地语音还需要相应依赖与硬件配置。
          </p>
          <aside
            class="rights-notice"
            id="rights-notice"
            aria-labelledby="rights-title"
          >
            <h3 id="rights-title" data-i18n="rightsTitle">
              Kurisu 角色与语音使用声明
            </h3>
            <p data-i18n="rightsOwnership">
              牧濑红莉栖（Kurisu）出自《STEINS;GATE》。原作版权署名为
              ©MAGES./NITRO
              PLUS；角色设定、形象及相关美术素材的权利归各自原权利人所有。原作语音、录音及表演相关权利归相应权利人所有。
            </p>
            <p data-i18n="rightsUsage">
              本项目涉及的 Kurisu
              角色与语音内容仅供非商业的技术学习、研究与演示参考。禁止第三方将相关角色素材、语音资源及其衍生内容用于售卖、付费分发、商业推广或其他营利性传播。
            </p>
            <p data-i18n="rightsScope">
              本项目为非官方项目，不代表原作权利方或配音演员，亦不表示获得其授权或背书。本声明不构成素材授权，学习或非商业用途也不等于已获授权；使用与再分发须遵守原权利人的许可及适用法律。上述素材不属于
              Amadeus 代码开源许可证的授权范围。
            </p>
            <a
              href="https://steinsgate.jp/reboot/ja-jp/"
              data-i18n="rightsSource"
              >原作官方版权署名 ↗</a
            >
          </aside>
        </div>
      </section>

      <section
        id="start"
        class="getting-started shell section-space"
        aria-labelledby="start-title"
      >
        <div class="section-heading">
          <div>
            <p class="eyebrow">03 / GET STARTED</p>
            <h2 id="start-title" data-i18n="startTitle">快速上手</h2>
          </div>
          <p data-i18n="startIntro">目前提供 Alpha 源码版本。建议先完成文字对话的基础配置，再按需添加语音与角色。</p>
        </div>
        <div class="steps">
          <article>
            <span class="step-number">01 /</span>
            <h3 data-i18n="stepOne">运行基础项目</h3>
            <p data-i18n="stepOneBody">按照系统对应的文档安装源码，并配置模型连接。先确认文字对话与任务执行可以正常使用。</p>
            <a
              href="https://github.com/Code-Amadeus/Amadeus/blob/main/README_ZH.md#快速开始"
              data-doc="quickstart"
              ><span data-i18n="quickstart">快速开始</span> ↗</a
            >
          </article>
          <article>
            <span class="step-number">02 /</span>
            <h3 data-i18n="stepTwo">选择语音配置</h3>
            <p data-i18n="stepTwoBody">需要语音时，可按安装文档选择远程 API 或本地模型。角色与场景资源按需添加。</p>
            <a
              href="https://github.com/Code-Amadeus/Amadeus/blob/main/docs/install_profiles.md"
              ><span data-i18n="profiles">查看安装配置</span> ↗</a
            >
          </article>
          <article>
            <span class="step-number">03 /</span>
            <h3 data-i18n="stepThree">安装资源并检查设置</h3>
            <p data-i18n="stepThreeBody">按资源包说明完成校验与安装，再到 Settings 检查模型、语音和角色状态。</p>
            <a
              href="https://github.com/Code-Amadeus/Amadeus/blob/main/docs/external_asset_bundles.md"
              ><span data-i18n="assetGuide">资源安装指南</span> ↗</a
            >
          </article>
        </div>
        <div class="install-terminal">
          <div>
            <span class="eyebrow">RESOURCE INSTALLATION</span>
            <p data-i18n="terminalDescription">
              将 asset-bundle.zip 替换为下载的资源包路径，在项目根目录执行。
            </p>
          </div>
          <div class="terminal-code">
            <div class="terminal-top">
              <span class="mono" data-i18n="terminalLabel"
                >已完成基础环境安装后</span
              ><button id="copy-command" type="button" data-i18n="copy">
                复制命令
              </button>
            </div>
            <pre><code id="install-command">python tools/external_assets.py verify "asset-bundle.zip"
python tools/external_assets.py install "asset-bundle.zip"
python tools/external_assets.py status</code></pre>
            <span id="copy-status" role="status" aria-live="polite"></span>
          </div>
        </div>
      </section>

      <section class="community shell" aria-labelledby="community-title">
        <div>
          <p class="eyebrow">BUILT IN THE OPEN</p>
          <h2 id="community-title" data-i18n="communityTitle">实验室招人</h2>
          <p data-i18n="communityBody">欢迎提交问题、改进代码，或制作自己的角色资源。</p>
        </div>
        <div class="community-links">
          <a href="https://github.com/Code-Amadeus/Amadeus"
            ><span data-i18n="sourceCode">查看源码</span> ↗</a
          ><a href="https://github.com/Code-Amadeus/Amadeus/issues"
            ><span data-i18n="feedback">问题与反馈</span> ↗</a
          ><a href="https://github.com/Code-Amadeus/Amadeus-SpriteForge"
            ><span>SpriteForge</span> ↗</a
          ><a
            href="https://github.com/Code-Amadeus/Amadeus/blob/main/docs/character_pack_authoring.md"
            ><span data-i18n="authoring">角色包制作指南</span> ↗</a
          >
        </div>
      </section>
    </main>
    <footer class="site-footer shell">
      <div>
        <a class="footer-brand" href="#">CODE AMADEUS<span>·</span></a
        ><span class="mono">VOICE / PRESENCE / ACTION</span>
      </div>
      <p data-i18n="licenseNote">
        第一方代码采用
        AGPL-3.0。角色、声音、模型与演示素材遵循各自条款，代码开源许可不包含这些素材的使用或再分发授权。
      </p>
      <a
        href="https://github.com/Code-Amadeus/Amadeus/blob/main/LICENSE"
        data-i18n="license"
        >代码许可证 ↗</a
      >
    </footer>
  </body>
</html>
